{
  "openapi": "3.0.3",
  "info": {
    "title": "ERPNext sandbox",
    "version": "16",
    "description": "Frappe REST API of the ERPNext sandbox; list responses wrap rows in data; by default only name is returned unless fields is passed.",
    "x-fitit-suggestions": [
      "Add a card with today's revenue",
      "Show the Sales revenue card without VAT",
      "Make the Sales orders card count only Aurora Clinic",
      "Hide paid invoices in the Invoice Status chart"
    ]
  },
  "paths": {
    "/api/resource/Sales Invoice": {
      "get": {
        "summary": "List Sales Invoice records",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "JSON array of field names, e.g. [\"name\",\"customer\",\"grand_total\",\"outstanding_amount\",\"posting_date\",\"status\"]. Without it only name is returned.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "JSON array of filters, e.g. [[\"status\",\"=\",\"Overdue\"]].",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit_page_length",
            "in": "query",
            "required": false,
            "description": "Maximum rows to return (default 20, 0 for all).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "customer": {
                            "type": "string"
                          },
                          "posting_date": {
                            "type": "string"
                          },
                          "grand_total": {
                            "type": "number"
                          },
                          "outstanding_amount": {
                            "type": "number"
                          },
                          "status": {
                            "type": "string"
                          },
                          "due_date": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
