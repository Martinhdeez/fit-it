      "post": {
        "summary": "FITIT Overview open tasks list",
        "description": "Called by the FITIT Overview workspace (/desk/selling/fitit-overview). Request body is form-encoded; hooks read it as ctx.request['form'] with JSON values already decoded. Fields: doctype (Task), fields, filters, order_by, page_length. Response {\"message\": {\"keys\": [field names], \"values\": [[row values in keys order], ...]}}. No dry run: use ctx.request.get('form', {}) / ctx.request.get('query', {}) so an empty ctx.request is safe. ",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "message": {
                    "keys": [
                      "name",
                      "subject",
                      "status"
                    ],
                    "values": [
                      [
                        "FITIT-TASK-1",
                        "Call Aurora",
                        "Open"
                      ]
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/method/frappe.desk.reportview.get_list": {
      "get": {
        "summary": "Generic list; the overview's customer cards use it for Customer, Sales Order and Sales Invoice",
        "description": "Called by the FITIT Overview workspace (/desk/selling/fitit-overview). Query: doctype, fields, filters, limit (ctx.request['query']). Response {\"message\": [rows]}. Customer cards read doctype=Customer, Sales Order (customer, name) and Sales Invoice (customer, base_grand_total, outstanding_amount). No dry run: use ctx.request.get('form', {}) / ctx.request.get('query', {}) so an empty ctx.request is safe. ",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "message": [
                    {
                      "name": "FITIT Aurora Clinic",
                      "customer_name": "FITIT Aurora Clinic"
                    }
                  ]
                }
              }
            }
          }
        }
      }
