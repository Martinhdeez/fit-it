      "post": {
        "summary": "FITIT Overview shortcut counts (Customers, Sales orders, ...)",
        "description": "Called by the FITIT Overview workspace (/desk/selling/fitit-overview). Request body is form-encoded; hooks read it as ctx.request['form'] with JSON values already decoded. Fields: doctype, filters. Response {\"message\": <count>}. No dry run: use ctx.request.get('form', {}) / ctx.request.get('query', {}) so an empty ctx.request is safe. ",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "message": 12
                }
              }
            }
          }
        }
      }
    },
